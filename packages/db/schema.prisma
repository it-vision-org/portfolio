generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Auth — single admin (me). No roles; the backoffice is gated
// by the ADMIN_EMAILS allowlist, not by a DB column.
// ─────────────────────────────────────────────────────────────
model User {
  id                   String    @id @default(cuid())
  name                 String
  email                String    @unique
  password             String
  passwordResetToken   String?   @unique
  passwordResetExpires DateTime?
  isDeleted            Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  contactSubmissions ContactSubmission[]

  @@index([email])
}

// ─────────────────────────────────────────────────────────────
// Site-wide content — a single row (id = "singleton")
// ─────────────────────────────────────────────────────────────
model SiteSettings {
  id String @id @default("singleton")

  navbarLogoUrl String?
  homeLogoUrl   String?

  // Hero
  heroName    String @default("Ahmed Zouaghi")
  heroTitle   String @default("Software Developer")
  heroTagline String @default("Full-stack web & mobile developer, UI/UX & graphic designer.") @db.Text
  heroCtaText String @default("View Projects")

  // About
  aboutHeading  String  @default("About Me")
  aboutText     String  @default("") @db.Text
  aboutImageUrl String?

  // Resume
  resumeHeading String  @default("My Resume")
  cvPdfUrl      String?

  // Contact block
  contactHeading   String  @default("Let's Create Together")
  contactText      String  @default("Ready to bring your ideas to life? Get in touch.") @db.Text
  contactEmail     String  @default("ahmedzouaghi2003@gmail.com")
  whatsappNumber   String? // Tunisia (WhatsApp only)
  whatsappLabel    String? @default("Tunisia (WhatsApp only)")
  phoneNumber      String? // Türkiye
  phoneLabel       String? @default("Türkiye")
  primaryLocation  String? @default("Sfax, Tunisia")
  currentResidency String? @default("Konya, Türkiye")

  // Socials
  githubUrl    String? // personal GitHub profile
  githubOrgUrl String? // organization GitHub
  linkedinUrl  String?
  instagramUrl String?
  youtubeUrl   String?

  footerText String @default("Built with Passion & Tech.")

  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────
// Resume — Skills matrix
// ─────────────────────────────────────────────────────────────
model SkillCategory {
  id        String   @id @default(cuid())
  name      String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  skills Skill[]
}

model Skill {
  id    String @id @default(cuid())
  name  String
  order Int    @default(0)

  categoryId String
  category   SkillCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
}

// ─────────────────────────────────────────────────────────────
// Resume — Education
// ─────────────────────────────────────────────────────────────
model Education {
  id          String   @id @default(cuid())
  degree      String
  institution String
  period      String
  description String?  @db.Text
  order       Int      @default(0)
  createdAt   DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────
// Resume — Certifications (title + one or more images)
// ─────────────────────────────────────────────────────────────
model Certification {
  id        String   @id @default(cuid())
  title     String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  images CertificationImage[]
}

model CertificationImage {
  id    String @id @default(cuid())
  url   String
  order Int    @default(0)

  certificationId String
  certification   Certification @relation(fields: [certificationId], references: [id], onDelete: Cascade)

  @@index([certificationId])
}

// ─────────────────────────────────────────────────────────────
// Services — the 4 focus areas (admin-managed)
// ─────────────────────────────────────────────────────────────
model Service {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  icon        String   @default("Code2") // lucide-react icon name
  features    String[]
  order       Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────
// Projects
// ─────────────────────────────────────────────────────────────
enum ProjectCategory {
  WEB
  MOBILE
  UIUX
  GRAPHIC
}

model Project {
  id            String          @id @default(cuid())
  title         String
  slug          String          @unique
  category      ProjectCategory
  summary       String?         @db.Text
  description   String?         @db.Text
  coverImageUrl String?
  tags          String[]
  order         Int             @default(0)
  isPublished   Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  // liveUrl / githubUrl are external links. videoUrl is an uploaded video
  // (UploadThing) played inline. lighthouseImageUrl is an uploaded screenshot.
  liveUrl            String?
  videoUrl           String?
  githubUrl          String?
  lighthouseImageUrl String?

  // UI/UX: Figma screenshots shown in a modal gallery / lightbox.
  images ProjectImage[]

  @@index([category])
  @@index([isPublished])
}

model ProjectImage {
  id      String  @id @default(cuid())
  url     String
  caption String?
  order   Int     @default(0)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

// ─────────────────────────────────────────────────────────────
// Graphic Design — 4 sliders (logos, app icons, covers, posts)
// ─────────────────────────────────────────────────────────────
enum GraphicSection {
  LOGO
  APP_ICON
  COVER
  POST
}

// Which colour theme an image should be shown in (BOTH = always).
enum ThemeVisibility {
  BOTH
  LIGHT
  DARK
}

model GraphicItem {
  id        String          @id @default(cuid())
  section   GraphicSection
  title     String?
  imageUrl  String
  theme     ThemeVisibility @default(BOTH)
  order     Int             @default(0)
  createdAt DateTime        @default(now())

  @@index([section])
}

// ─────────────────────────────────────────────────────────────
// Trusted customers — logo (+ which theme it shows in)
// ─────────────────────────────────────────────────────────────
model Client {
  id        String          @id @default(cuid())
  name      String?
  logoUrl   String
  theme     ThemeVisibility @default(BOTH)
  order     Int             @default(0)
  createdAt DateTime        @default(now())
}

// ─────────────────────────────────────────────────────────────
// Contact form submissions
// ─────────────────────────────────────────────────────────────
model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([isRead])
  @@index([createdAt])
}
