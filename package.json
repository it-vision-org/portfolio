{
  "name": "ahmed-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "postinstall": "prisma generate --schema=packages/db/schema.prisma",
    "build": "prisma generate --schema=packages/db/schema.prisma && next build",
    "start": "next start",
    "lint": "next lint",
    "check-types": "tsc --noEmit",
    "db:generate": "prisma generate --schema=packages/db/schema.prisma",
    "db:push": "prisma db push --schema=packages/db/schema.prisma --skip-generate",
    "db:seed": "prisma db seed"
  },
  "prisma": {
    "schema": "packages/db/schema.prisma",
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} packages/db/seed.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@neondatabase/serverless": "^0.10.4",
    "@prisma/adapter-neon": "5.22.0",
    "@prisma/client": "^5.22.0",
    "@prisma/nextjs-monorepo-workaround-plugin": "^7.10.0",
    "@shoestore/db": "workspace:*",
    "@shoestore/utils": "workspace:*",
    "@uploadthing/react": "^7.3.1",
    "bcryptjs": "^3.0.2",
    "jose": "^5.9.6",
    "lucide-react": "^0.487.0",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hot-toast": "^2.5.2",
    "resend": "^4.1.2",
    "uploadthing": "^7.7.4",
    "ws": "^8.21.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.9",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22",
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3",
    "@types/ws": "^8.18.1",
    "prisma": "^5.22.0",
    "tailwindcss": "^4.0.9",
    "ts-node": "^10.9.2",
    "typescript": "5.7.3"
  }
}
